{
  "name": "spectral-freeze-wam",
  "version": "0.2.2",
  "description": "Headless Web Audio Module build of Spectral Freeze",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/casperleerink/spectral-freeze-rust.git",
    "directory": "wam-shell"
  },
  "homepage": "https://github.com/casperleerink/spectral-freeze-rust#readme",
  "bugs": {
    "url": "https://github.com/casperleerink/spectral-freeze-rust/issues"
  },
  "type": "module",
  "license": "MIT OR Apache-2.0",
  "files": [
    "dist",
    "descriptor.json",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./processor": {
      "types": "./dist/SpectralFreezeWamProcessor.d.ts",
      "default": "./dist/SpectralFreezeWamProcessor.js"
    },
    "./wasm": "./dist/spectral_freeze_wam.wasm",
    "./descriptor": "./descriptor.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build:wasm": "cargo build -p spectral-freeze-wam --target wasm32-unknown-unknown --release",
    "build:package": "node scripts/build-package.mjs",
    "build": "npm run build:wasm && npm run build:package",
    "check:types": "tsc -p tsconfig.check.json",
    "prepack": "npm run build:package"
  },
  "keywords": [
    "web-audio",
    "wam",
    "audio-worklet",
    "wasm",
    "spectral",
    "freeze"
  ],
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
